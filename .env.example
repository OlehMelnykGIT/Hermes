# Скопіюйте у .env.local для `vercel dev` або задайте у Vercel → Settings → Environment Variables.
# Справжні значення НІКОЛИ не комітьте.

# Пароль для входу на сайт
SITE_PASSWORD=

# Випадковий рядок, мінімум 32 символи. Згенерувати: openssl rand -base64 48
SESSION_SECRET=

# Посилання на Google Таблицю (видно лише після входу)
SHEET_URL=

# Apps Script Web App (Api.gs): URL з /exec, токен читання і токен запису (Linki, Notatki)
SHEET_API_URL=
SHEET_API_TOKEN=
SHEET_API_WRITE_TOKEN=
